# Local PostgreSQL (or a Neon connection string)
DATABASE_URL="postgresql://postgres:YOUR_PG_PASSWORD@127.0.0.1:5432/kotaana?schema=public"

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
AUTH_TRUST_HOST="true"
AUTH_URL="https://your-app.vercel.app"   # production URL (helps OAuth + email links)

# Google OAuth (Sign in with Google) — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Google Gemini API — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── Multi-model AI Router (server only — never NEXT_PUBLIC_*) ──
# GEMINI_API_KEY is set above.
OPENROUTER_API_KEY=
# Optional model overrides (defaults are set in src/lib/ai/models.ts)
# AI_EVERYDAY_MODEL=gemini-2.5-flash-lite
# AI_VISION_MODEL=gemini-2.5-flash
# AI_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_REASONING_MODEL=deepseek/deepseek-r1-0528:free
# AI_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
# AI_LONG_CONTEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free


# Payments (Stripe) and email (Resend) will be added later.

# --- Added: payments, storage, health ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MOMO_API_KEY=""
MOMO_USER_ID=""
MOMO_PRIMARY_KEY=""
MOMO_CALLBACK_URL=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Optional: bootstrap app owner on seed (role=admin). Prefer /owner-auth first-time setup.
# OWNER_EMAIL="you@example.com"
# OWNER_PASSWORD="change-me-long"
# OWNER_NAME="App Owner"


# MoMo-only payments (no Stripe/cards for now)
# Platform collection code shown in-app: 8787
# STRIPE_* keys ignored while MoMo manual approval is active


# Optional: Google Maps JS (draw GPS routes on Track page — restrict key by domain)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Added: found referenced in code but missing from this file ---
# Public app URL (used for links in emails/notifications, invite URLs, etc.)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
# Shared secret required in the `x-cron-secret` header on /api/jobs/* and
# /api/admin/jobs cron-style routes. Generate with: openssl rand -hex 24
CRON_SECRET=""
# Shown to athletes as the platform's own MoMo pay-in code/name (manual approval flow)
PLATFORM_MOMO_CODE="8787"
PLATFORM_MOMO_NAME=""
# Optional: Google Health Connect / Fit client id (src/lib/health/track-me.ts)
GOOGLE_HEALTH_CLIENT_ID=""
